APP_NAME=JobCopilot
APP_ENV=development

# ==================== 认证 ====================
SECRET_KEY=change-me-to-a-random-long-string-for-jobcopilot
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 数据库 ====================
DATABASE_URL=sqlite:///./jobcopilot.db

# ==================== 对话模型（DeepSeek，OpenAI 兼容） ====================
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.3

# ==================== Embedding（阿里百炼专属端点，OpenAI 兼容） ====================
EMBEDDING_BASE_URL=https://ws-qhkijshmatylj7e6.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ==================== 前端跨域 ====================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
